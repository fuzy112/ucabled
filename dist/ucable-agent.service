[Unit]
Description=Phone Passkey Bridge UI agent
# Graphical-session-bound, not default.target: linger starts default.target
# with no login (and no DISPLAY/WAYLAND_DISPLAY). The compositor starts
# graphical-session.target after importing its environment.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/local/bin/ucable-agent
Restart=on-failure
NoNewPrivileges=true
LimitCORE=0
MemorySwapMax=0

[Install]
WantedBy=graphical-session.target
