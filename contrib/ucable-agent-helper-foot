#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Minimal ucable-agent helper (Contract v3) built on the foot terminal.
# Dependencies: foot, qrencode, bash.
#
# Select with:
#   services.ucabled.helper = "/path/to/contrib/ucable-agent-helper-foot";
# or export UCABLED_HELPER=/path/to/contrib/ucable-agent-helper-foot.
#
# Contract notes:
# - The caBLE URL arrives on stdin and is only ever piped into qrencode
#   inside the terminal; it never touches argv, logs, or the filesystem.
# - argv is display-only: the RP arrives as `--rp <value>`, and anything
#   else — in particular a FIDO:/ argument — is ignored. stdin is the only
#   URL channel.
# - foot attaches its child to a pty, so the agent's stdin pipe cannot be
#   read from inside the terminal directly. A 0600 FIFO under
#   $XDG_RUNTIME_DIR forwards the stream; a FIFO stores nothing on disk,
#   data only passes through the kernel pipe buffer. The in-terminal script
#   unlinks the FIFO right after opening it (the open fd stays valid).
# - `exec foot`, so the agent's lifecycle SIGKILL lands on foot itself and
#   the window always disappears with the transaction.
# - any keypress cancels (exit 1); the timeout is enforced by the keypress
#   read.

set -eu

rp=""
rtype=""
timeout_s=300
also_key=0

while [ $# -gt 0 ]; do
    case "$1" in
        --timeout) timeout_s=$2; shift ;;
        --request-type) rtype=$2; shift ;;
        --also-key) also_key=1 ;;
        --rp) rp=$2; shift ;;
        --rp=*) rp=${1#--rp=} ;;
        # argv is display-only; anything unknown (in particular a FIDO:/
        # URL, which must only ever arrive on stdin) is ignored.
        *) ;;
    esac
    shift
done

runtime_dir=${XDG_RUNTIME_DIR:-/tmp}
fifo=$(mktemp -u "$runtime_dir/ucabled-helper.XXXXXX")
mkfifo -m 600 "$fifo"

# Forward the agent's stdin (URL line, then status lines) into the FIFO.
# The explicit <&0 matters: without it the shell hands the background job
# /dev/null as stdin and the URL never reaches the terminal. Dies to SIGPIPE
# once the in-terminal reader goes away.
cat <&0 >"$fifo" &

# Positional parameters are the inner bash's, hence the single quotes.
# shellcheck disable=SC2016
exec foot --app-id ucabled --title "Passkey" --window-size-chars 76x34 \
    bash -c '
        set -u
        fifo=$1 rp=$2 timeout_s=$3 rtype=${4:-}
        exec 3<"$fifo"
        rm -f "$fifo"
        IFS= read -r url <&3
        case "$url" in
            FIDO:/*) ;;
            *)
                printf "expected a FIDO:/ URL on stdin, got \"%s\"\n" "$url" >&2
                printf "(this helper is meant to be launched by ucable-agent;\n" >&2
                printf "to smoke-test: printf \"FIDO:/TEST\\\\n\" | ucable-agent-helper-foot)\n" >&2
                read -rsn1 -t 10 || :
                exit 1
                ;;
        esac
        clear
        qrencode -t ANSIUTF8 -m 2 -- "$url"
        [ -n "$rp" ] && printf "\n  %s\n" "$rp"
        printf "\n  Scan with your phone\n"
        case "$rtype" in
            mc) printf "  to store a passkey\n" ;;
            ga) printf "  to authenticate with passkeys\n" ;;
        esac
        [ "$also_key" = 1 ] &&
            printf "\n  (or touch the connected security key instead)\n"
        printf "\n  Press any key to cancel.\n"
        (
            while IFS= read -r line <&3; do
                [ "$line" = found ] &&
                    printf "\n  === phone detected, confirm on your phone ===\n"
            done
        ) &
        watcher=$!
        read -rsn1 -t "$timeout_s" || :
        kill "$watcher" 2>/dev/null || :
        exit 1
    ' _ "$fifo" "$rp" "$timeout_s" "$rtype" "$also_key"
