msgid "Scan with your phone"
msgstr "スマートフォンでスキャン"

msgid "Phone detected"
msgstr "スマートフォンを検出しました"

msgid "Confirm the sign-in on your phone"
msgstr "スマートフォンでサインインを確認してください"

msgid "Code expired"
msgstr "コードの有効期限が切れました"

msgid "Close this window and start again."
msgstr "このウィンドウを閉じて、もう一度やり直してください。"

msgid "Passkey request"
msgstr "パスキーのリクエスト"

msgid "A security key is also connected. Use your phone's passkey instead?"
msgstr "セキュリティキーも接続されています。代わりにスマートフォンのパスキーを使いますか？"

msgid "Keep using the security key"
msgstr "セキュリティキーを使い続ける"

msgid "Use phone"
msgstr "スマートフォンを使用"
