msgid "Scan with your phone"
msgstr "Отсканируйте телефоном"

msgid "Phone detected"
msgstr "Телефон обнаружен"

msgid "Confirm the sign-in on your phone"
msgstr "Подтвердите вход на телефоне"

msgid "Code expired"
msgstr "Срок действия кода истёк"

msgid "Close this window and start again."
msgstr "Закройте это окно и начните заново."

msgid "Passkey request"
msgstr "Запрос ключа доступа"

msgid "A security key is also connected. Use your phone's passkey instead?"
msgstr "Также подключён ключ безопасности. Использовать вместо него ключ доступа с телефона?"

msgid "Keep using the security key"
msgstr "Продолжить с ключом безопасности"

msgid "Use phone"
msgstr "Использовать телефон"

msgid "Scan with your phone\nto authenticate with passkeys"
msgstr "Отсканируйте телефоном\nчтобы войти с ключом доступа"

msgid "Scan with your phone\nto store a passkey"
msgstr "Отсканируйте телефоном\nчтобы сохранить ключ доступа"
