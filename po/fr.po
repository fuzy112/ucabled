msgid "Scan with your phone"
msgstr "Scannez avec votre téléphone"

msgid "Phone detected"
msgstr "Téléphone détecté"

msgid "Confirm the sign-in on your phone"
msgstr "Confirmez la connexion sur votre téléphone"

msgid "Code expired"
msgstr "Code expiré"

msgid "Close this window and start again."
msgstr "Fermez cette fenêtre et recommencez."

msgid "Passkey request"
msgstr "Demande de clé d'accès"

msgid "A security key is also connected. Use your phone's passkey instead?"
msgstr "Une clé de sécurité est également connectée. Utiliser plutôt la clé d'accès de votre téléphone ?"

msgid "Keep using the security key"
msgstr "Continuer avec la clé de sécurité"

msgid "Use phone"
msgstr "Utiliser le téléphone"

msgid "Scan with your phone\nto authenticate with passkeys"
msgstr "Scannez avec votre téléphone\npour vous authentifier avec des clés d'accès"

msgid "Scan with your phone\nto store a passkey"
msgstr "Scannez avec votre téléphone\npour enregistrer une clé d'accès"
