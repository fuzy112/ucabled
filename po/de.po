msgid "Scan with your phone"
msgstr "Mit dem Telefon scannen"

msgid "Phone detected"
msgstr "Telefon erkannt"

msgid "Confirm the sign-in on your phone"
msgstr "Bestätigen Sie die Anmeldung auf Ihrem Telefon"

msgid "Code expired"
msgstr "Code abgelaufen"

msgid "Close this window and start again."
msgstr "Schließen Sie dieses Fenster und beginnen Sie von vorn."

msgid "Passkey request"
msgstr "Passkey-Anfrage"

msgid "A security key is also connected. Use your phone's passkey instead?"
msgstr "Es ist auch ein Sicherheitsschlüssel verbunden. Stattdessen den Passkey Ihres Telefons verwenden?"

msgid "Keep using the security key"
msgstr "Sicherheitsschlüssel weiter verwenden"

msgid "Use phone"
msgstr "Telefon verwenden"

msgid "Scan with your phone\nto authenticate with passkeys"
msgstr "Mit dem Telefon scannen\num sich mit Passkeys zu authentifizieren"

msgid "Scan with your phone\nto store a passkey"
msgstr "Mit dem Telefon scannen\num einen Passkey zu speichern"
