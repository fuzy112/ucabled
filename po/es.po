#: src/bin/ucable-agent-helper.rs:114
msgid ""
"Scan with your phone\n"
"to store a passkey"
msgstr ""
"Escanea con tu teléfono\n"
"para guardar una clave de acceso"

#: src/bin/ucable-agent-helper.rs:116
msgid ""
"Scan with your phone\n"
"to authenticate with passkeys"
msgstr ""
"Escanea con tu teléfono\n"
"para autenticarte con claves de acceso"

#: src/bin/ucable-agent-helper.rs:118
msgid "Scan with your phone"
msgstr "Escanea con tu teléfono"

#: src/bin/ucable-agent-helper.rs:505 src/bin/ucable-agent-helper.rs:635
#: src/bin/ucable-agent-helper.rs:694
msgid "Passkey request"
msgstr "Solicitud de clave de acceso"

#: src/bin/ucable-agent-helper.rs:538
msgid "Code expired"
msgstr "Código caducado"

#: src/bin/ucable-agent-helper.rs:539
msgid "Close this window and start again."
msgstr "Cierra esta ventana y vuelve a empezar."

#: src/bin/ucable-agent-helper.rs:563
msgid "Phone detected"
msgstr "Teléfono detectado"

#: src/bin/ucable-agent-helper.rs:564
msgid "Confirm the sign-in on your phone"
msgstr "Confirma el inicio de sesión en tu teléfono"

#: src/bin/ucable-agent-helper.rs:640
msgid "A security key is also connected. Use your phone's passkey instead?"
msgstr ""
"También hay una clave de seguridad conectada. ¿Usar la clave de acceso de tu "
"teléfono en su lugar?"

#: src/bin/ucable-agent-helper.rs:650
msgid "Keep using the security key"
msgstr "Seguir usando la clave de seguridad"

#: src/bin/ucable-agent-helper.rs:654
msgid "Use phone"
msgstr "Usar el teléfono"
