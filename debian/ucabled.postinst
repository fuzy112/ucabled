#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

# The debhelper snippets create the ucabled service account (systemd-sysusers)
# and enable the unit, but do not start it: dh_installsystemd is called with
# --no-start so the daemon comes up only after the runtime prerequisites below
# exist.
#DEBHELPER#

case "$1" in
configure)
	# The system bus and polkitd only read their policy files at
	# startup.  dbus-send works with both dbus-daemon and dbus-broker.
	if command -v dbus-send >/dev/null 2>&1; then
		dbus-send --system --type=method_call \
			--dest=org.freedesktop.DBus / \
			org.freedesktop.DBus.ReloadConfig >/dev/null 2>&1 || true
	fi
	# polkitd re-reads its actions on SIGHUP.  deb-systemd-invoke goes
	# through policy-rc.d and is a no-op without a running systemd.
	deb-systemd-invoke reload polkit.service >/dev/null 2>&1 || true

	# /dev/uhid gets the ucabled ACL from the udev rule just installed,
	# so load the module and re-apply the rules now that the account
	# exists.
	command -v modprobe >/dev/null 2>&1 && modprobe uhid 2>/dev/null || true
	if command -v udevadm >/dev/null 2>&1; then
		udevadm control --reload-rules >/dev/null 2>&1 || true
		udevadm trigger --subsystem-match=misc >/dev/null 2>&1 || true
	fi

	# Everything the daemon needs is in place now.  restart starts a
	# stopped daemon on a fresh install and restarts a running one on
	# upgrade; deb-systemd-invoke honours policy-rc.d and leaves a unit
	# the admin disabled alone.
	deb-systemd-invoke daemon-reload >/dev/null 2>&1 || true
	deb-systemd-invoke restart ucabled.service >/dev/null 2>&1 || true
	;;
esac

exit 0
