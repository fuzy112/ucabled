#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

if [ "$1" = "purge" ]; then
	# The persistent caBLE identity key lives in /var/lib/ucabled, which
	# systemd's StateDirectory= creates at runtime and which is therefore
	# not part of the package's file list.  Purging drops it.
	rm -rf /var/lib/ucabled

	# The service account comes from
	# /usr/lib/sysusers.d/ucabled.conf and is not removed by the package
	# manager on its own.
	if getent passwd ucabled >/dev/null 2>&1; then
		userdel ucabled >/dev/null 2>&1 || true
	fi
	if getent group ucabled >/dev/null 2>&1; then
		groupdel ucabled >/dev/null 2>&1 || true
	fi
fi

#DEBHELPER#

exit 0
