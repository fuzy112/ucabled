#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

# dh_installsystemd runs with --no-start, which also suppresses its stop
# snippet, so stop the daemon here when the package is removed.  Upgrades
# keep it running; the postinst restarts it once the new files are in place.
case "$1" in
remove)
	if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
		deb-systemd-invoke stop ucabled.service >/dev/null 2>&1 || true
	fi
	;;
esac

#DEBHELPER#

exit 0
