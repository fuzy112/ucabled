#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

# dh_installsystemduser enables ucable-agent.service for all users and
# removes that enablement on purge.  It does not start or restart user
# units in compat 13, so do that here for the sessions that are already
# running.
#DEBHELPER#

case "$1" in
configure)
	[ -z "${DPKG_ROOT:-}" ] || exit 0
	[ -d /run/systemd/system ] || exit 0
	command -v systemctl >/dev/null 2>&1 || exit 0
	command -v loginctl >/dev/null 2>&1 || exit 0

	# On a fresh install no agent is running yet: start it for sessions
	# that are already up, unless the GNOME Shell extension is installed,
	# since both register for the daemon's single agent slot and the
	# extension is opt-in per user.  On upgrade, restart the running agent
	# so the new binary takes effect without a re-login.
	start_now=
	if [ -z "$2" ] &&
		! dpkg-query -W -f='${Status}' ucable-gnome-agent 2>/dev/null |
			grep -q ' install ok installed$'; then
		start_now=1
	fi

	loginctl list-users --no-legend 2>/dev/null |
	while read -r uid user _; do
		case "$uid" in '' | *[!0-9]*) continue ;; esac
		[ "$uid" -ge 1000 ] || continue
		[ -d "/run/user/$uid" ] || continue

		systemctl --user --machine="$user@.host" daemon-reload \
			>/dev/null 2>&1 || true
		systemctl --user --machine="$user@.host" try-restart \
			ucable-agent.service >/dev/null 2>&1 || true
		if [ -n "$start_now" ] &&
			systemctl --user --machine="$user@.host" is-active \
				--quiet graphical-session.target 2>/dev/null; then
			systemctl --user --machine="$user@.host" start \
				ucable-agent.service >/dev/null 2>&1 || true
		fi
	done
	;;
esac

exit 0
