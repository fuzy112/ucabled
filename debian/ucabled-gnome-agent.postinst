#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

#DEBHELPER#

if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
	cat <<'EOF'
The GNOME Shell agent is installed but stays disabled.  Enable it per
user, then log out and back in (Wayland cannot reload the shell):

    gnome-extensions enable ucabled-agent@fuzy.me

It replaces ucable-agent, the default session agent.  If both are
installed, disable the service so they do not compete for the daemon's
single agent slot:

    systemctl --user disable --now ucable-agent.service
EOF
fi

exit 0
