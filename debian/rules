#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Debian/Ubuntu packaging for ucabled.
#
# The unit files, udev rule, D-Bus policy, polkit action, manual pages,
# shell completions and translations are single-sourced from dist/ and
# po/, the same files install.sh and the NixOS module use.  This file only
# rewrites the manual installer's /usr/local prefix to /usr and arranges
# the files for a Debian system.

include /usr/share/dpkg/default.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export CARGO_TERM_COLOR = never
# Hardening flags for the C parts of the dependency tree (ring's assembly
# and C glue) and for the final link.
export CFLAGS CXXFLAGS CPPFLAGS LDFLAGS

# The GTK4 helper derives <prefix>/share/locale from its own location; pin
# it at compile time so the catalogs are found wherever dh_install puts the
# binary.
export UCABLED_LOCALEDIR = /usr/share/locale

# Override to build with a different toolchain, for example one installed
# by rustup when the distribution's rustc is older than Cargo.toml's MSRV:
#   dpkg-buildpackage -b -us -uc -d -- CARGO=...   (or debian/rules binary CARGO=...)
CARGO ?= cargo

PKGDIR = debian/ucabled

%:
	dh $@

# gtk4 0.11, already pinned by the lockfile, needs rustc 1.92.  Say so
# plainly instead of letting cargo fail on an opaque edition error.
override_dh_auto_build:
	@set -e; \
	msrv=$$(sed -n 's/^rust-version *= *"\([0-9.]*\)".*/\1/p' Cargo.toml); \
	have=$$($(CARGO) --version 2>/dev/null | awk '$$1 == "cargo" { print $$2 }'); \
	if [ -n "$$msrv" ] && [ -n "$$have" ]; then \
		dpkg --compare-versions "$$have" ge "$$msrv" || { \
			echo "error: cargo $$have is older than the $$msrv required by Cargo.toml" >&2; \
			echo "hint:  build with a newer toolchain, e.g. debian/rules binary CARGO=\$$HOME/.cargo/bin/cargo" >&2; \
			exit 1; \
		}; \
	fi
	$(CARGO) build --release --locked

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(CARGO) test --release --locked
endif

override_dh_auto_clean:
	rm -rf target

# Everything that needs a hand: the files generated from dist/, the unit
# files rewritten for /usr, the completions no dh_* helper covers (zsh and
# fish) and the gettext catalogs.  dh_install ships the binaries, the udev
# rule and the D-Bus/polkit policy; dh_installman the manual pages.
override_dh_auto_install:
	# The service account, plus the postinst snippet that creates it.  This
	# has to run before dh_installsystemd so the account exists by the time
	# the daemon is started.
	dh_installsysusers

	install -d $(PKGDIR)/usr/lib/systemd/system \
		$(PKGDIR)/usr/lib/systemd/user \
		$(PKGDIR)/usr/lib/modules-load.d
	# install.sh rewrites the same /usr/local prefix; the package lives in
	# /usr.  dist/ stays the single source for the unit contents.
	sed 's|/usr/local/bin/|/usr/bin/|g' dist/ucabled.service \
		> $(PKGDIR)/usr/lib/systemd/system/ucabled.service
	sed 's|/usr/local/bin/|/usr/bin/|g' dist/ucable-agent.service \
		> $(PKGDIR)/usr/lib/systemd/user/ucable-agent.service
	# Load uhid at boot so the udev rule can grant the service account rw
	# on /dev/uhid.
	printf 'uhid\n' > $(PKGDIR)/usr/lib/modules-load.d/ucabled.conf

	install -Dm644 dist/completions/ucabled.bash \
		$(PKGDIR)/usr/share/bash-completion/completions/ucabled
	install -Dm644 dist/completions/ucable-agent-helper.bash \
		$(PKGDIR)/usr/share/bash-completion/completions/ucable-agent-helper
	install -Dm644 dist/completions/_ucabled \
		$(PKGDIR)/usr/share/zsh/site-functions/_ucabled
	install -Dm644 dist/completions/_ucable-agent-helper \
		$(PKGDIR)/usr/share/zsh/site-functions/_ucable-agent-helper
	install -Dm644 dist/completions/ucabled.fish \
		$(PKGDIR)/usr/share/fish/vendor_completions.d/ucabled.fish
	install -Dm644 dist/completions/ucable-agent-helper.fish \
		$(PKGDIR)/usr/share/fish/vendor_completions.d/ucable-agent-helper.fish

	# gettext catalogs for the GTK4 helper (the only localized binary).
	for po in po/*.po; do \
		lang=$${po#po/}; lang=$${lang%.po}; \
		install -d $(PKGDIR)/usr/share/locale/$$lang/LC_MESSAGES; \
		msgfmt "$$po" -o \
			$(PKGDIR)/usr/share/locale/$$lang/LC_MESSAGES/ucable-agent-helper-gtk.mo; \
	done

# The first start is done by hand in postinst, once the service account,
# the /dev/uhid ACL and the bus policy exist (see debian/ucabled.postinst).
# Upgrades still try-restart a running daemon.
override_dh_installsystemd:
	dh_installsystemd --no-start
